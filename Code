import java.util.Scanner;
import java.text.DecimalFormat;

public class Solution {

	public static void main(String[] args) {
		
		Scanner sc = new Scanner(System.in);
		DecimalFormat df = new DecimalFormat("0.00");
		
		int code = sc.nextInt();
		double hours = sc.nextDouble();
		
		String name = "";
		double baseFee = 0.0;
		double addFee = 0.0;
		
		if (code < 1 || code > 3 || hours <= 0) {
			System.out.println("Invalid Input");
		} else {
			
			if (code == 1) {
				name = "Motorcycle";
				baseFee = 2.00;
				addFee = 1.00;
			} else if (code == 2) {
				name = "Car";
				baseFee = 5.00;
				addFee = 2.00;
			} else if (code == 3) {
				name = "Van";
				baseFee = 8.00;
				addFee = 3.00;
			}
			
			double totalFee = 0.0;
			
			if (hours <= 2.0) {
				totalFee = baseFee;
			} else {
				double addHours = hours - 2.0;
				int wholeAddHours = (int) addHours;
				if (addHours > wholeAddHours) {
					wholeAddHours = wholeAddHours + 1;
				}
				
				totalFee = baseFee + (wholeAddHours * addFee);
			}
			
			System.out.println("+++++++++++++++++++++");
			System.out.println("Gateway Smart Parking");
			System.out.println("+++++++++++++++++++++");
			System.out.println(name);
			System.out.println(hours);
			System.out.println("RM " + df.format(totalFee));
		}
		
	}
}
